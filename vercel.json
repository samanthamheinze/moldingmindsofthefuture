{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "grocerystore.moldingmindsofthefuture.com"
        }
      ],
      "destination": "/grocery-store/$1"
    },
    {
      "source": "/",
      "destination": "/home/"
    }
  ],
  "functions": {
    "api/admin/campaigns/[id]/send.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/online-tools",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/online-tools/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/math-diagnostic/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reading-diagnostic/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/freebie/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
