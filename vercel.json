{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "grocerystore.moldingmindsofthefuture.com" }],
      "destination": "/grocery-store/$1"
    },
    {
      "source": "/",
      "destination": "/home/"
    }
  ],
  "functions": {
    "api/admin/campaigns/[id]/send.js": { "maxDuration": 60 }
  }
}
